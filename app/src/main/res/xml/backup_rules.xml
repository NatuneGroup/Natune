<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <exclude domain="sharedpref" path="kmp_secure_credentials.xml" />
    <!-- Sign-ins share the settings store; WebView and TDLib also persist sessions. -->
    <exclude domain="file" path="./datastore/settings.preferences_pb" />
    <exclude domain="root" path="app_webview" />
    <exclude domain="file" path="./telegram/db" />
    <exclude
        domain="file"
        path="./exoplayer" />
    <exclude
        domain="file"
        path="./download" />
    <exclude
        domain="file"
        path="./feedback" />
    <exclude
        domain="database"
        path="exoplayer_internal.db" />
    <exclude
        domain="file"
        path="./datastore/listener_presence.preferences_pb" />
    <exclude
        domain="database"
        path="restore-pending" />
    <exclude
        domain="file"
        path="./custom_fonts/restore-pending" />
    <exclude
        domain="file"
        path="./datastore/restore-pending" />
</full-backup-content>
