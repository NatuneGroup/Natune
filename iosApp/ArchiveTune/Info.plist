            <key>CPTemplateApplicationSceneSessionRoleApplication</key><array><dict>
                <key>UISceneConfigurationName</key><string>NatuneCarPlay</string>
                <key>UISceneClassName</key><string>CPTemplateApplicationScene</string>
                <key>UISceneDelegateClassName</key><string>$(PRODUCT_MODULE_NAME).NatuneCarPlayScene</string>
            </dict></array>
