// Consumes the static iOS closure written by scripts/build_ios_native_core.sh (macOS and Xcode only; not run on Linux).
// Keep the -l names below in step with that script's CLOSURE_ARCHIVES list, in the same dependency order.
// Never point an iOS linker at desktop binaries or recovered reference libraries.
ARCHIVETUNE_NATIVE_ROOT = $(SRCROOT)/../shared-data/build/ios-native/$(PLATFORM_NAME)
FRAMEWORK_SEARCH_PATHS = $(inherited) "$(SRCROOT)/../shared-ui/build/xcode-frameworks/$(CONFIGURATION)/$(SDK_NAME)"
HEADER_SEARCH_PATHS = $(inherited) "$(SRCROOT)/Native" "$(SRCROOT)/../desktopApp/native/include" "$(ARCHIVETUNE_NATIVE_ROOT)/include"
// The TDLib closure archive is static, so its export header must not expect a shared tdjson.
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) TDJSON_STATIC_DEFINE=1
LIBRARY_SEARCH_PATHS = $(inherited) "$(ARCHIVETUNE_NATIVE_ROOT)/lib"
OTHER_LDFLAGS = $(inherited) -framework ArchiveTuneShared -larchivetune_engine -larchivetune_telegram -lavfilter -lavformat -lavcodec -lswscale -lswresample -lavutil -lssl -lcrypto -lxml2 -lz -liconv -lc++ -framework AVFoundation -framework AVKit -framework AudioToolbox -framework CoreAudio -framework QuartzCore -framework MediaPlayer -framework ImageIO -framework Security -framework AuthenticationServices -framework WebKit -framework SystemConfiguration
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
CLANG_CXX_LANGUAGE_STANDARD = c++17
ENABLE_USER_SCRIPT_SANDBOXING = NO
IPHONEOS_DEPLOYMENT_TARGET = 16.0
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
// The Kotlin/Native closure ships iosArm64 + iosSimulatorArm64 only; without this Xcode's default
// simulator ARCHS (arm64 x86_64) make :shared-ui:syncComposeResourcesForIos fail on 'x86_64'.
EXCLUDED_ARCHS[sdk=iphonesimulator*] = x86_64
SUPPORTS_MACCATALYST = NO
SWIFT_VERSION = 5.0
TARGETED_DEVICE_FAMILY = 1,2
PRODUCT_BUNDLE_IDENTIFIER = moe.rukamori.archivetune
PRODUCT_NAME = ArchiveTune
INFOPLIST_FILE = ArchiveTune/Info.plist
GENERATE_INFOPLIST_FILE = NO
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
// Release workflows override both values on the xcodebuild command line.
ARCHIVETUNE_VERSION_NAME = 0.1.0
ARCHIVETUNE_VERSION_CODE = 1
CURRENT_PROJECT_VERSION = $(ARCHIVETUNE_VERSION_CODE)
MARKETING_VERSION = $(ARCHIVETUNE_VERSION_NAME)
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks

// The Telegram api_id and api_hash reach the app through Info.plist. Leave them blank here; set them in the untracked
// Configuration/Credentials.xcconfig or as Xcode build settings. Blank values keep Telegram not configured.
ARCHIVETUNE_TELEGRAM_API_ID =
ARCHIVETUNE_TELEGRAM_API_HASH =
// The TIDAL OAuth clients reach the app through Info.plist the same way. Blank values keep TIDAL sign-in not
// configured: the device flow needs an id and a secret, and the unprefixed pair is the fallback the desktop reads.
ARCHIVETUNE_TIDAL_CLIENT_ID =
ARCHIVETUNE_TIDAL_CLIENT_SECRET =
ARCHIVETUNE_TIDAL_DEVICE_CLIENT_ID =
ARCHIVETUNE_TIDAL_DEVICE_CLIENT_SECRET =
ARCHIVETUNE_TIDAL_PKCE_CLIENT_ID =
ARCHIVETUNE_TIDAL_PKCE_CLIENT_SECRET =
// The opt-in listener presence origin reaches the app through Info.plist the same way. A blank value sends nothing.
// xcconfig treats // as a comment, so write the scheme as https:/$()/host when setting it in an xcconfig file.
ARCHIVETUNE_LISTENER_PRESENCE_URL =
// The Last.fm application key pair reaches the app through Info.plist the same way. A blank pair leaves Last.fm
// sign-in not configured. Libre.fm uses the built-in compatibility pair, and a custom endpoint can enter its own.
ARCHIVETUNE_LASTFM_API_KEY =
ARCHIVETUNE_LASTFM_API_SECRET =
// The Amazon Turnstile sitekey and origin are a pair: set both or neither. CI writes them into Credentials.xcconfig;
// Info.plist forwards them to IosProviderCredentials for the authorization sheet.
ARCHIVETUNE_AMAZON_TURNSTILE_SITEKEY =
ARCHIVETUNE_AMAZON_TURNSTILE_ORIGIN =
// The TIDAL canvas embed token reaches the app through Info.plist the same way. A blank value leaves the TIDAL
// canvas provider not configured; the better-lyrics resolver still answers canvas requests without it.
ARCHIVETUNE_TIDAL_CANVAS_EMBED_TOKEN =
// The built-in Lyprio lyrics server pair reaches the app through Info.plist the same way; both must be set for the
// bundled endpoint to exist, and a user's own server entry always wins. xcconfig treats // as a comment, so write
// the scheme as https:/$()/host when setting it in an xcconfig file.
ARCHIVETUNE_LYPRIO_BASE_URL =
ARCHIVETUNE_LYPRIO_HMAC_KEY =
// The dedicated ArchivePool deployment override; blank keeps the SOURCE_PROVIDER_URL value, then the public default.
ARCHIVETUNE_ARCHIVEPOOL_BASE_URL =
// The registered public OAuth client id of the Librespot Spotify streaming sign-in reaches the app through
// Info.plist the same way. It is a PKCE public client, never a secret; a blank value keeps that sign-in unavailable.
ARCHIVETUNE_SPOTIFY_OAUTH_CLIENT_ID =
// The Google OAuth client of type "iOS" for Drive app-data backup reaches the app through Info.plist the same
// way: an iOS client of the app's bundle id in a Google Cloud project with the Drive API and the drive.appdata
// scope. It is a public installed-app client, never a secret. CFBundleURLTypes always registers the resolved
// bundle id ($(PRODUCT_BUNDLE_IDENTIFIER)), a scheme Google accepts for iOS clients, so no build can produce an
// empty scheme entry; an explicit URL scheme is only an override, and sign-in falls back to the reversed client
// id (com.googleusercontent.apps.<id>) when it is blank. A blank client id keeps the Drive section not-configured.
ARCHIVETUNE_GOOGLE_DRIVE_CLIENT_ID =
ARCHIVETUNE_GOOGLE_DRIVE_URL_SCHEME =
#include? "Credentials.xcconfig"
