{
  "format": "archivetune.module",
  "formatVersion": 1,
  "apiVersion": 1,
  "entry": "provider.js",
  "module": {
    "id": "app.natune.provider.tidal.instance",
    "name": "TIDAL public instance",
    "displayName": "TIDAL public instance",
    "version": "1.0.0",
    "author": "Natune contributors",
    "description": "No account required. Uses your community instance /search/ and /track/ protocol, plaintext BTS or unprotected DASH. Explicit user endpoint; no embedded account, discovery key or server list.",
    "repository": "https://github.com/NatuneGroup/Natune",
    "license": "GPL-3.0-or-later",
    "type": [
      "audio_provider"
    ],
    "requiredRuntimeFeatures": [
      "fetch@1",
      "settings@1",
      "streamResolution@1"
    ],
    "capabilities": [
      "searchTracks",
      "getTrackStreamUrl"
    ],
    "settings": {
      "instanceUrl": {
        "type": "text",
        "label": "Instance URL",
        "description": "Your HTTPS community or private instance; no built-in account or server list.",
        "defaultValue": null,
        "required": true
      },
      "quality": {
        "type": "select",
        "label": "Audio quality",
        "description": "",
        "defaultValue": "LOSSLESS",
        "required": false,
        "options": [
          {
            "label": "FLAC",
            "value": "LOSSLESS"
          },
          {
            "label": "Hi-Res FLAC",
            "value": "HI_RES_LOSSLESS"
          },
          {
            "label": "AAC high",
            "value": "HIGH"
          },
          {
            "label": "AAC low",
            "value": "LOW"
          }
        ]
      }
    }
  }
}
