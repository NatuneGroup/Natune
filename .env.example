# Optional development overrides. Debug builds work without provider credentials.
# Copy to the ignored .env, fill only what you need, then export before Gradle:
# set -a; . ./.env; set +a
# Values compiled into an APK are public. Never use server administrator secrets.
# Provider credentials injected at build time; the variable list and feature per variable are in
# docs/build-credentials.md. A blank value leaves the dependent feature "not configured".
# Environment values win over local.properties, which wins over Gradle properties.
ARCHIVETUNE_LASTFM_API_KEY=
ARCHIVETUNE_LASTFM_API_SECRET=
ARCHIVETUNE_AMAZON_TURNSTILE_SITEKEY=
ARCHIVETUNE_AMAZON_TURNSTILE_ORIGIN=
ARCHIVETUNE_YOUTUBE_OAUTH_CLIENT_ID=
ARCHIVETUNE_YOUTUBE_OAUTH_CLIENT_SECRET=
ARCHIVETUNE_POTOKEN_GOOGLE_API_KEY=
ARCHIVETUNE_POTOKEN_REQUEST_KEY=
ARCHIVETUNE_TIDAL_CLIENT_ID=
ARCHIVETUNE_TIDAL_CLIENT_SECRET=
ARCHIVETUNE_TIDAL_PKCE_CLIENT_ID=
ARCHIVETUNE_TIDAL_PKCE_CLIENT_SECRET=
ARCHIVETUNE_TIDAL_CANVAS_EMBED_TOKEN=
# Desktop host (also overridable at launch through the environment or -D<NAME>=<value>).
ARCHIVETUNE_TIDAL_DEVICE_CLIENT_ID=
ARCHIVETUNE_TIDAL_DEVICE_CLIENT_SECRET=
ARCHIVETUNE_JIOSAAVN_DES_KEY=
ARCHIVETUNE_LISTENER_PRESENCE_URL=
# Legacy Last.fm names, still read when the ARCHIVETUNE_LASTFM_* names are blank.
LASTFM_API_KEY=
LASTFM_SECRET=
# Optional numeric override; leave unset to retain the shipped public app ID.
# DISCORD_APPLICATION_ID=
START_IO_APP_ID=
SOURCE_PROVIDER_URL=
SOURCE_PROVIDER_KEY=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Release signing is intentionally absent. Use the existing CI Secrets and
# historical release identity, never a checked-in or shared development keystore.
